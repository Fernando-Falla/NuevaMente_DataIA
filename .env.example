GOOGLE_API_KEY=your_google_api_key_here
# Opcional: clave propia para Data/IA (si falta, se usa GOOGLE_API_KEY)
# DATAIA_GOOGLE_API_KEY=your_google_api_key_here
# Opcional: modelo para la metadata pedagógica
# GEMINI_MODEL=gemini-3.1-flash-lite

# Opcional: límites de tamaño (se rechaza antes de llamar al LLM)
# DATAIA_MAX_FILE_MB=25
# DATAIA_MAX_PAGES=300
# DATAIA_MAX_DOCUMENT_TOKENS=150000
# DATAIA_DOC_METADATA_MAX_TOKENS=8000

# Opcional: control de ritmo (valores prudentes para la cuenta gratuita de Gemini)
# IA_PROVIDER_RPM=10
# IA_PROVIDER_TPM=200000
# IA_EMBEDDING_RPM=100
# IA_EMBEDDING_TPM=20000
# IA_PROVIDER_QUOTA_RETRIES=2
# DATAIA_EMBEDDING_BATCH_SIZE=20

# Opcional: proveedor de LLM por etapa (gemini o groq). Groq requiere GROQ_API_KEY;
# si falla o no hay clave, la etapa usa Gemini.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# IA_PROVIDER_CLASIFICACION=gemini
# IA_PROVIDER_GENERACION=gemini
# IA_PROVIDER_CRITICO=gemini
# IA_GROQ_RPM=30
# IA_GROQ_TPM=8000
# IA_GROQ_MAX_PROMPT_TOKENS=5600

# Opcional: embeddings (local por defecto: fastembed en CPU, sin cuota; o gemini)
# DATAIA_EMBEDDINGS=local
# DATAIA_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# DATAIA_MODELS_DIR=.dataia_models
